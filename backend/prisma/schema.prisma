generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  RW
  RT
  PENGURUS_MASJID
  SUPERADMIN
}

enum StatusAkun {
  PENDING
  APPROVED
  REJECTED
}

enum JenisTransaksi {
  MASUK
  KELUAR
}

enum StatusIuran {
  LUNAS
  BELUM
}

enum StatusSetoran {
  BELUM
  PENDING
  TERKONFIRMASI
}

enum JenisBayar {
  UANG
  BERAS
}

enum StatusKehadiran {
  HADIR
  LIBUR
  IZIN
  ALFA
}

enum StatusInsiden {
  LAPORAN
  PROSES
  SELESAI
  DITUTUP
}

enum TipeDokumen {
  KTP
  PASPORT
  SIM
  LAINNYA
}

enum AksiAudit {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
}

model User {
  id               String           @id @default(uuid())
  nama             String
  email            String           @unique
  password         String
  no_hp            String
  blok_wilayah_id  String?
  role             Role
  status_akun      StatusAkun       @default(PENDING)
  alasan_penolakan String?          @db.Text
  created_at       DateTime         @default(now())
  
  blok_wilayah     BlokWilayah?     @relation(fields: [blok_wilayah_id], references: [id])
  wilayah_rw       WilayahRW?
  pengurus_masjid  PengurusMasjid[]
  preference       UserPreference?
  audit_logs       AuditLog[]

  @@map("users")
}

model WilayahRW {
  id            String        @id @default(uuid())
  user_id       String        @unique
  nama_kompleks String
  no_rw         String
  
  user          User          @relation(fields: [user_id], references: [id])
  blok_wilayah  BlokWilayah[]
  kas_rw        KasRW[]
  laporan_insiden LaporanInsiden[]
  pengaturan_iuran PengaturanIuranRW?
  setoran_iuran   SetoranIuranRT[]

  @@map("wilayah_rw")
}

model BlokWilayah {
  id            String      @id @default(uuid())
  wilayah_rw_id String
  nama_blok     String
  no_rt         String?
  created_at    DateTime    @default(now())
  
  wilayah_rw    WilayahRW   @relation(fields: [wilayah_rw_id], references: [id])
  masjid        Masjid[]
  users         User[]
  warga         Warga[]
  performa_ronda PerformaRonda[]
  kas_rt        KasRT[]
  setoran_iuran SetoranIuranRT[]

  @@map("blok_wilayah")
}

model Masjid {
  id              String           @id @default(uuid())
  blok_wilayah_id String
  nama_masjid     String
  alamat          String           @db.Text
  
  blok_wilayah    BlokWilayah      @relation(fields: [blok_wilayah_id], references: [id])
  pengurus_masjid PengurusMasjid[]
  transaksi_zis   TransaksiZis[]
  kas_masjid      KasMasjid[]
  pengaturan_zis  PengaturanZis?

  @@map("masjid")
}

model PengurusMasjid {
  id        String @id @default(uuid())
  user_id   String
  masjid_id String
  
  user      User   @relation(fields: [user_id], references: [id])
  masjid    Masjid @relation(fields: [masjid_id], references: [id])

  @@map("pengurus_masjid")
}

model Warga {
  id                  String            @id @default(uuid())
  blok_wilayah_id     String
  nama_kk             String
  deleted_at          DateTime?
  
  blok_wilayah        BlokWilayah       @relation(fields: [blok_wilayah_id], references: [id])
  iuran_warga         IuranWarga[]
  anggota_keluarga    AnggotaKeluarga[]
  identitas           IdentitasWarga[]
  cicilan_iuran       CicilanIuran[]

  @@map("warga")
}

model AnggotaKeluarga {
  id              String    @id @default(uuid())
  warga_id        String
  nama            String
  hubungan        String
  nik             String?
  tanggal_lahir   DateTime?
  pendidikan      String?
  pekerjaan       String?
  deleted_at      DateTime?
  created_at      DateTime  @default(now())
  
  warga           Warga     @relation(fields: [warga_id], references: [id])

  @@map("anggota_keluarga")
}

model IdentitasWarga {
  id              String      @id @default(uuid())
  warga_id        String
  tipe_dokumen    TipeDokumen
  nomor_dokumen   String
  tanggal_terbit  DateTime?
  tanggal_berlaku DateTime?
  dokumen_url     String?
  verified_at     DateTime?
  verified_by     String?
  deleted_at      DateTime?
  created_at      DateTime    @default(now())
  
  warga           Warga       @relation(fields: [warga_id], references: [id])

  @@map("identitas_warga")
}

model IuranWarga {
  id            String           @id @default(uuid())
  warga_id      String
  bulan         Int
  tahun         Int
  nominal       Decimal          @db.Decimal(10, 2)
  nominal_kas_rt  Decimal?       @db.Decimal(10, 2)
  nominal_kas_rw  Decimal?       @db.Decimal(10, 2)
  status        StatusIuran      @default(BELUM)
  kode_unik     String?          @unique
  tanggal_bayar DateTime?
  setoran_id    String?
  
  warga         Warga            @relation(fields: [warga_id], references: [id])
  cicilan       CicilanIuran[]
  setoran       SetoranIuranRT?  @relation(fields: [setoran_id], references: [id])

  @@map("iuran_warga")
}

model CicilanIuran {
  id                String      @id @default(uuid())
  warga_id          String
  iuran_id          String
  total_cicilan     Decimal     @db.Decimal(10, 2)
  nominal_per_bulan Decimal     @db.Decimal(10, 2)
  jumlah_bulan      Int
  bulan_mulai       Int
  tahun_mulai       Int
  sudah_lunas       Boolean     @default(false)
  created_at        DateTime    @default(now())
  
  warga             Warga       @relation(fields: [warga_id], references: [id])
  iuran             IuranWarga  @relation(fields: [iuran_id], references: [id])

  @@map("cicilan_iuran")
}

model KasRW {
  id              String         @id @default(uuid())
  wilayah_rw_id   String
  jenis_transaksi JenisTransaksi
  tanggal         DateTime       @default(now())
  keterangan      String         @db.Text
  nominal         Decimal        @db.Decimal(10, 2)
  bukti_url       String?
  bukti_foto_url  String?
  kode_unik       String         @unique
  
  wilayah_rw      WilayahRW      @relation(fields: [wilayah_rw_id], references: [id])

  @@map("kas_rw")
}

model KasMasjid {
  id              String         @id @default(uuid())
  masjid_id       String
  jenis_transaksi JenisTransaksi
  tanggal         DateTime       @default(now())
  keterangan      String         @db.Text
  nominal         Decimal        @db.Decimal(10, 2)
  bukti_url       String?
  kode_unik       String         @unique

  masjid          Masjid         @relation(fields: [masjid_id], references: [id])

  @@map("kas_masjid")
}

model TransaksiZis {
  id               String     @id @default(uuid())
  masjid_id        String
  kode_unik        String     @unique
  nama_kk          String
  alamat_muzaqi    String
  jumlah_jiwa      Int
  jenis_bayar      JenisBayar
  nominal_zakat    Decimal    @default(0) @db.Decimal(10, 2)
  nominal_infaq    Decimal    @default(0) @db.Decimal(10, 2)
  total_beras_kg   Decimal    @default(0) @db.Decimal(10, 2)
  waktu_transaksi  DateTime   @default(now())
  
  masjid           Masjid     @relation(fields: [masjid_id], references: [id])

  @@map("transaksi_zis")
}

model PengaturanZis {
  id                  String  @id @default(uuid())
  masjid_id           String  @unique
  persen_fakir        Float   @default(62.5)
  persen_amil         Float   @default(8.0)
  persen_fisabilillah Float   @default(11.0)
  persen_lainnya      Float   @default(18.5)
  harga_beras_per_kg  Decimal @db.Decimal(10, 2)
  is_harga_auto_api   Boolean @default(false)
  
  masjid              Masjid  @relation(fields: [masjid_id], references: [id])

  @@map("pengaturan_zis")
}

model PerformaRonda {
  id               String          @id @default(uuid())
  blok_wilayah_id  String
  tanggal          DateTime
  nama_petugas     String
  status_kehadiran StatusKehadiran
  catatan          String?
  created_at       DateTime        @default(now())
  
  blok_wilayah     BlokWilayah     @relation(fields: [blok_wilayah_id], references: [id])

  @@map("performa_ronda")
}

model LaporanInsiden {
  id                      String        @id @default(uuid())
  wilayah_rw_id           String
  tipe_insiden            String
  tanggal_insiden         DateTime
  lokasi                  String
  deskripsi               String        @db.Text
  status                  StatusInsiden @default(LAPORAN)
  pelapor_nama            String
  pelapor_no_hp           String?
  foto_bukti_url          String?
  ditindaklanjuti_tanggal DateTime?
  tindakan_diambil        String?       @db.Text
  created_at              DateTime      @default(now())
  updated_at              DateTime      @updatedAt
  
  wilayah_rw              WilayahRW     @relation(fields: [wilayah_rw_id], references: [id])

  @@map("laporan_insiden")
}

model AuditLog {
  id          String      @id @default(uuid())
  user_id     String
  aksi        AksiAudit
  entitas     String
  entitas_id  String
  data_lama   String?     @db.Text
  data_baru   String?     @db.Text
  keterangan  String?     @db.Text
  ip_address  String?
  created_at  DateTime    @default(now())
  
  user        User        @relation(fields: [user_id], references: [id])

  @@map("audit_log")
}

model UserPreference {
  id                String    @id @default(uuid())
  user_id           String    @unique
  dark_mode         Boolean   @default(false)
  tema_warna        String?   @default("blue")
  bahasa            String?   @default("id")
  notifikasi_email  Boolean   @default(true)
  notifikasi_sms    Boolean   @default(true)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  
  user              User      @relation(fields: [user_id], references: [id])

  @@map("user_preference")
}

model ShareLink {
  id          String      @id @default(uuid())
  token       String      @unique
  scope       String
  scope_id    String
  expires_at  DateTime?
  revoked_at  DateTime?
  created_at  DateTime    @default(now())

  @@index([scope, scope_id])
  @@index([expires_at])
  @@map("share_link")
}

model PengaturanIuranRW {
  id              String      @id @default(uuid())
  wilayah_rw_id   String      @unique
  nominal_iuran   Decimal     @db.Decimal(10, 2)
  persen_rt       Float       @default(70.0)
  persen_rw       Float       @default(30.0)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  
  wilayah_rw      WilayahRW   @relation(fields: [wilayah_rw_id], references: [id])

  @@map("pengaturan_iuran_rw")
}

model KasRT {
  id              String         @id @default(uuid())
  blok_wilayah_id String
  jenis_transaksi JenisTransaksi
  tanggal         DateTime       @default(now())
  keterangan      String         @db.Text
  nominal         Decimal        @db.Decimal(10, 2)
  bukti_url       String?
  kode_unik       String         @unique
  
  blok_wilayah    BlokWilayah    @relation(fields: [blok_wilayah_id], references: [id])

  @@map("kas_rt")
}

model SetoranIuranRT {
  id              String         @id @default(uuid())
  blok_wilayah_id String
  wilayah_rw_id   String
  nominal         Decimal        @db.Decimal(10, 2)
  status          StatusSetoran  @default(PENDING)
  tanggal_setor   DateTime       @default(now())
  tanggal_konfirmasi DateTime?
  bukti_url       String?
  
  blok_wilayah    BlokWilayah    @relation(fields: [blok_wilayah_id], references: [id])
  wilayah_rw      WilayahRW      @relation(fields: [wilayah_rw_id], references: [id])
  iuran_warga     IuranWarga[]

  @@map("setoran_iuran_rt")
}

