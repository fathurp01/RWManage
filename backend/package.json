{
  "name": "rwmanage-backend",
  "version": "1.0.0",
  "description": "Express.js + TypeScript API server for RWManage (Rumah Warga Management System)",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,json --legacy-watch --signal SIGTERM --exec tsx src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "db:push": "npx prisma db push",
    "db:deploy": "npx prisma migrate deploy",
    "db:seed": "npx prisma db seed",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:security": "jest --testPathPatterns=security --runInBand"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@types/pg": "^8.20.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@prisma/client": "^7.7.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "prisma": "^7.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "5.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
